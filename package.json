{
  "name": "rifd-demo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:browser": "playwright test",
    "test:browser:api": "playwright test --config playwright.api.config.ts",
    "test:acceptance": "node scripts/acceptance.mjs",
    "test:delivery": "RIFD_HOSTING=1 playwright test --config playwright.delivery.config.ts",
    "test:performance": "node scripts/performance.mjs",
    "verify:performance": "node scripts/verify-performance.mjs",
    "check:css-sources": "node scripts/check-css-sources.mjs",
    "preview": "node scripts/serve-static.mjs",
    "emulators": "firebase emulators:start --only hosting --project demo-rifd",
    "build:domain": "pnpm --filter @rifd/domain build",
    "skills:validate": "intent validate packages/rifd-domain --check",
    "skills:stale": "node scripts/skill-sources.mjs",
    "skills:review": "node scripts/skill-sources.mjs --record",
    "skills:check": "pnpm skills:validate && node scripts/skill-sources.mjs --check",
    "skills:list": "intent list",
    "skills:load": "intent load",
    "test:skills": "node --test tests/skills/*.test.mjs",
    "pack:domain": "node scripts/pack-domain.mjs"
  },
  "dependencies": {
    "@rifd/domain": "workspace:*",
    "@tanstack/react-router": "1.170.44",
    "@tanstack/react-start": "1.169.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/intent": "0.5.5",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.1",
    "lighthouse": "13.5.0",
    "pdf-lib": "1.17.1",
    "puppeteer-core": "25.9.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "intent": {
    "skills": [
      "workspace:@rifd/domain#validate-application",
      "workspace:@rifd/domain#freeze-repayment"
    ],
    "exclude": [
      "*#experimental-*"
    ]
  }
}
