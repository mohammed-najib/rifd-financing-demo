# Environment file for the hosted `liveAnalysis` function. Firebase CLI loads
# `.env.<project-id>` from this directory on deploy and in the emulator, so for
# the project in `.firebaserc` create the real file by copying the example and
# filling in your own values:
#
#   cp functions/.env.rifd-portfolio-mdnb.example \
#      functions/.env.rifd-portfolio-mdnb
#
# The real file is gitignored. Replace the project ID in the name whenever you
# deploy to a different project.

# Firebase web app ID for the project. Find it with:
#   firebase apps:list --project <project-id>
# or under Project settings > Your apps in the Firebase console.
LIVE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000

# Trusted ingress for the Cloud Run v2 function, as JSON:
#   profile   - always "cloud-run-v2"
#   authority - host that requests must be addressed to;
#               "<region>-<project-id>.cloudfunctions.net"
#   peers     - proxy addresses allowed in X-Forwarded-For (1 to 8 entries)
# The value is validated strictly; a bad or missing configuration disables the
# ingress proof. Use the addresses Cloud Run reports for your own deployment
# rather than copying these verbatim.
LIVE_TRUSTED_INGRESS='{"profile":"cloud-run-v2","authority":"europe-west1-<project-id>.cloudfunctions.net","peers":["169.254.169.126"]}'