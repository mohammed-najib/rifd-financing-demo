{
  "hosting": {
    "public": "dist/client",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "headers": [
      {
        "source": "**",
        "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
      },
      {
        "source": "/assets/**",
        "headers": [{ "key": "Cache-Control", "value": "max-age=3600" }]
      },
      {
        "source": "/fonts/**",
        "headers": [{ "key": "Cache-Control", "value": "max-age=3600" }]
      }
    ],
    "rewrites": [{ "source": "**", "destination": "/_shell.html" }]
  },
  "emulators": {
    "hosting": { "host": "127.0.0.1", "port": 4173 },
    "ui": { "enabled": false },
    "singleProjectMode": true
  }
}
